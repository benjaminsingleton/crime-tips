# Copy to .env and adjust before docker compose up
# Production: run ./scripts/gen-secrets.sh then set DOMAIN + PUBLIC_ORIGIN

# --- Local / developer compose (docker compose up --build) ---
APP_PORT=8080
CRIME_TIPS_ENV=development

POSTGRES_DB=crimetips
POSTGRES_USER=crimetips
POSTGRES_PASSWORD=crimetips
POSTGRES_PORT=5432

# Prefer the Compose service hostname `db`. If container-to-container TCP is
# blocked in your environment, use host.docker.internal (extra_hosts is set):
# DATABASE_URL=postgres://crimetips:crimetips@host.docker.internal:5432/crimetips
DATABASE_URL=postgres://crimetips:crimetips@db:5432/crimetips

JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=12h

# Officer session cookie (JWT stored httpOnly; not in localStorage)
# SESSION_COOKIE_NAME=crime_tips_session
# COOKIE_SECURE=true|false  — default: true in production / when request is HTTPS
# COOKIE_SAMESITE=lax|strict|none  — use none only for true cross-site API + HTTPS

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme
ADMIN_RANK=Admin
ADMIN_FIRST_NAME=System
ADMIN_LAST_NAME=Administrator

# Comma-separated browser origins allowed for CORS (required for cross-origin prod API).
# Same-origin via Caddy typically uses https://tips.example.gov
PUBLIC_ORIGIN=

# Behind Caddy/Traefik/agency proxy set true so rate limits use X-Forwarded-For
TRUST_PROXY=false

# --- Production overlay (docker-compose.prod.yml) ---
# DOMAIN=tips.example.gov
# PUBLIC_ORIGIN=https://tips.example.gov
# CRIME_TIPS_ENV=production
# TRUST_PROXY=true
# HTTP_PORT=80
# HTTPS_PORT=443
#
# Pin the published app image (GHCR). Prefer a semver tag, not :latest, in prod.
# CRIME_TIPS_IMAGE=ghcr.io/benjaminsingleton/crime-tips:1.0.0
# Optional: never / missing / always (Compose pull_policy for app)
# CRIME_TIPS_PULL_POLICY=missing

# Optional SMTP for new-tip email notifications (otherwise logged as stub)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@crimetips.local

MAX_UPLOAD_BYTES=26214400
MAX_ATTACHMENTS_PER_TIP=10

# Optional rate-limit tuning
# RATE_LIMIT_LOGIN_MAX=10
# RATE_LIMIT_TIP_WRITE_MAX=60
# RATE_LIMIT_UPLOAD_MAX=30
# RATE_LIMIT_GLOBAL_MAX=300
