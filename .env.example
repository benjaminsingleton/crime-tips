# Copy to .env and adjust before docker compose up
# Production: run ./scripts/gen-secrets.sh then set DOMAIN + PUBLIC_ORIGIN

# --- Local / developer compose (docker compose up --build) ---
APP_PORT=8080
CRIME_TIPS_ENV=development

POSTGRES_DB=crimetips
POSTGRES_USER=crimetips
POSTGRES_PASSWORD=crimetips
POSTGRES_PORT=5432

# Prefer the Compose service hostname `db`. If container-to-container TCP is
# blocked in your environment, use host.docker.internal (extra_hosts is set):
# DATABASE_URL=postgres://crimetips:crimetips@host.docker.internal:5432/crimetips
DATABASE_URL=postgres://crimetips:crimetips@db:5432/crimetips

JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=12h

# Officer session cookie (JWT stored httpOnly; not in localStorage)
# SESSION_COOKIE_NAME=crime_tips_session
# COOKIE_SECURE=true|false  — default: true in production / when request is HTTPS
# COOKIE_SAMESITE=lax|strict|none  — default lax. Prefer same-origin Caddy.
#   none requires HTTPS + makes CSRF practical: Origin checks become strict
#   (also set PUBLIC_ORIGIN). Do not use none without understanding CSRF risk.
# CSRF_STRICT=true  — require Origin/Referer on cookie-auth mutations even with SameSite=lax

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme
ADMIN_RANK=Admin
ADMIN_FIRST_NAME=System
ADMIN_LAST_NAME=Administrator

# Comma-separated browser origins allowed for CORS (required for cross-origin prod API).
# Same-origin via Caddy typically uses https://tips.example.gov
PUBLIC_ORIGIN=

# Behind Caddy/Traefik/agency proxy set true so rate limits use X-Forwarded-For
TRUST_PROXY=false

# --- Production overlay (docker-compose.prod.yml) ---
# DOMAIN=tips.example.gov
# PUBLIC_ORIGIN=https://tips.example.gov
# CRIME_TIPS_ENV=production
# TRUST_PROXY=true
# HTTP_PORT=80
# HTTPS_PORT=443
#
# Pin the published app image (GHCR). Prod default / preflight refuse :latest.
# CRIME_TIPS_IMAGE=ghcr.io/benjaminsingleton/crime-tips:1.1.1
# Optional: never / missing / always (Compose pull_policy for app)
# CRIME_TIPS_PULL_POLICY=missing

# Optional SMTP for new-tip email notifications to officers with
# notifications enabled. If SMTP_HOST is empty, the API logs an [email stub]
# instead of sending (see docs/ops/email.md). PUBLIC_ORIGIN (above) is used
# to build the /tip/<id> link in the message when set.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@crimetips.local

MAX_UPLOAD_BYTES=26214400
MAX_ATTACHMENTS_PER_TIP=10

# Optional rate-limit tuning
# RATE_LIMIT_LOGIN_MAX=10
# RATE_LIMIT_TIP_WRITE_MAX=60
# RATE_LIMIT_UPLOAD_MAX=30
# RATE_LIMIT_GLOBAL_MAX=300

# Officer TOTP MFA (optional; password login remains available by default)
# MFA_REQUIRED=false          # true = all officers must enroll before dashboard use
# MFA_ISSUER=Crime Tips       # authenticator app label
# MFA_PENDING_TTL_SEC=300     # seconds for post-password MFA challenge token

# Optional agency OIDC SSO (disabled until OIDC_ISSUER + OIDC_CLIENT_ID are set)
# See docs/ops/auth-mfa.md — password + TOTP keep working unless OIDC_ALLOW_PASSWORD=false
# OIDC_ISSUER=https://login.example.gov/realms/pd
# OIDC_CLIENT_ID=crime-tips
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=https://tips.example.gov/api/auth/oidc/callback
#   (defaults to ${PUBLIC_ORIGIN}/api/auth/oidc/callback when unset)
# OIDC_SCOPES=openid email profile
# OIDC_EMAIL_CLAIM=email
# OIDC_BUTTON_LABEL=Sign in with agency SSO
# OIDC_ALLOW_PASSWORD=true    # false = SSO only (hide email/password form)
# OIDC_AUTO_PROVISION=false   # true = create officer on first SSO if email is new
# OIDC_DEFAULT_RANK=Officer   # rank for auto-provisioned accounts
# OIDC_ENABLED=true           # set false to force-disable even if issuer/client are set
# OIDC_ALLOW_INSECURE=false   # true only for local http:// IdPs (never in production)
# OIDC_REQUIRE_EMAIL_VERIFIED=true  # require IdP email_verified before email link / provision

# Department branding (no fork). Env = deploy defaults; admins can override in UI.
# See docs/ops/branding.md
# BRAND_NAME=Springfield PD Crime Tips
# BRAND_TAGLINE=Police tip line
# BRAND_LOGO_URL=https://example.gov/seal.png
# BRAND_PRIMARY_COLOR=#102033
# BRAND_ACCENT_COLOR=#b8974a
