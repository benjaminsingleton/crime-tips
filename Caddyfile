# Crime Tips — production reverse proxy (Caddy)
# Set DOMAIN in .env (e.g. tips.example.gov). For local TLS testing without
# public DNS, use DOMAIN=localhost (Caddy issues an internal cert).

{$DOMAIN:localhost} {
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	reverse_proxy app:3000
}
